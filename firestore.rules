rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if request is from the owner of the form
    function isFormOwner(formId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/forms/$(formId)).data.ownerUid ||
        request.auth.token.email == 'iskakfatoni@gmail.com'
      );
    }

    // ==========================================
    // KOLEKSI FORMULIR (FORMS)
    // ==========================================
    match /forms/{formId} {
      // 1. Publik / Responden BISA membaca formulir untuk mengisi form
      allow read: if true;
      
      // 2. Pembuatan form baru: Harus user login dan mencantumkan judul yang valid
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200;
                    
      // 3. Update & Delete: Diizinkan jika user adalah pemilik form (ownerUid) atau legacy form,
      //    ATAU jika responden publik hanya memperbarui counter responseCount dan lastResponseAt
      allow delete: if isAuthenticated() && (
        !('ownerUid' in resource.data) ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.token.email == 'iskakfatoni@gmail.com'
      );

      allow update: if (isAuthenticated() && (
        !('ownerUid' in resource.data) ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.token.email == 'iskakfatoni@gmail.com'
      )) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount', 'lastResponseAt'])
      );
    }
    
    // ==========================================
    // KOLEKSI TANGGAPAN / RESPON (RESPONSES)
    // ==========================================
    match /responses/{responseId} {
      // 1. Siapapun yang mengisi form BISA MENGIRIM TANGGAPAN BARU (Create)
      allow create: if request.resource.data.formId is string
                    && request.resource.data.answers is map;
      
      // 2. Membaca & Menghapus tanggapan: Hanya diizinkan untuk pemilik form atau admin
      allow read, delete: if isAuthenticated() && (
        ('formOwnerUid' in resource.data && resource.data.formOwnerUid == request.auth.uid) ||
        isFormOwner(resource.data.formId) ||
        request.auth.token.email == 'iskakfatoni@gmail.com'
      );
      
      // 3. Update respon jika diperlukan oleh pemilik form atau admin
      allow update: if isAuthenticated() && (
        ('formOwnerUid' in resource.data && resource.data.formOwnerUid == request.auth.uid) ||
        isFormOwner(resource.data.formId) ||
        request.auth.token.email == 'iskakfatoni@gmail.com'
      );
    }
  }
}
